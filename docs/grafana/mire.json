{
  "title": "Mire : ligne câble",
  "uid": "mire-ligne",
  "tags": [
    "mire",
    "docsis"
  ],
  "timezone": "browser",
  "description": "État de la ligne DOCSIS relevé par Mire (https://github.com/floopich/mire), d'après son point /metrics. Seuils des graphiques : profil VOO ; adaptez-les à votre opérateur.",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(mire_info, instance)",
          "refId": "V"
        },
        "definition": "label_values(mire_info, instance)",
        "includeAll": true,
        "multi": false,
        "current": {},
        "refresh": 2,
        "hide": 0,
        "allValue": ".*",
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "État de la ligne",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(mire_line_level{instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Non qualifié",
                  "color": "gray",
                  "index": 0
                },
                "1": {
                  "text": "Bon",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "Toléré",
                  "color": "blue",
                  "index": 2
                },
                "3": {
                  "text": "À surveiller",
                  "color": "orange",
                  "index": 3
                },
                "4": {
                  "text": "Critique",
                  "color": "red",
                  "index": 4
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "blue",
                "value": 2
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 4
              }
            ]
