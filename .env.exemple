# Facultatif : impose un réglage, qui est alors verrouillé dans la page Réglages.
# Copiez-le en .env à côté de compose.yaml, décommentez les lignes voulues et
# ajoutez « env_file: .env » au service. Protégez-le : chmod 600 .env.
# Valeur avec $, # ou espace : entre apostrophes, MIRE_MQTT_MOT_DE_PASSE='a $b'.
# Après un changement : docker compose up -d. Liste complète :
# docs/configuration.md.

# Fuseau horaire ; par défaut, celui de l'opérateur.
# TZ=Europe/Brussels

# Adresse de Mire, pour les liens des notifications et de Home Assistant.
# MIRE_NOTIF_ADRESSE=https://mire.exemple.be

# --- Modem et opérateur ---
# Mot de passe du modem, à la place de celui enregistré dans la base.
# MIRE_MODEM_MOT_DE_PASSE=
# Profil d'opérateur : voo, telenet ou generique.
# MIRE_PROFIL=voo

# --- Débit, lu dans Speedtest Tracker ou sur une passerelle UniFi ---
# Speedtest Tracker : jeton du menu API Tokens, droit « Read results ».
# UniFi : clé API de UniFi Network, ou compte local de la console.
# MIRE_DEBIT=true
# MIRE_DEBIT_SOURCE=speedtest-tracker
# MIRE_DEBIT_ADRESSE=http://192.168.1.10:8080
# MIRE_DEBIT_JETON=
# MIRE_DEBIT_IDENTIFIANT=
# MIRE_DEBIT_MOT_DE_PASSE=

# --- Météo, pour la page Tendance ---
# Open-Meteo, sans compte. Une commune, ou latitude, longitude.
# MIRE_METEO=true
# MIRE_METEO_POSITION=Namur

# --- Métriques (Prometheus, VictoriaMetrics, Grafana Alloy, Telegraf) ---
# Sur /metrics. Jeton facultatif (openssl rand -hex 24).
# MIRE_METRIQUES=true
# MIRE_METRIQUES_JETON=

# --- Home Assistant, par MQTT ---
# MIRE_MQTT=true
# MIRE_MQTT_SERVEUR=mqtt://192.168.1.10:1883
# MIRE_MQTT_IDENTIFIANT=
# MIRE_MQTT_MOT_DE_PASSE=
# Bouton « Redémarrer le modem » ; false pour le retirer.
# MIRE_MQTT_REDEMARRAGE=true
