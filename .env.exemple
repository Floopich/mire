# Facultatif. Tout se règle dans la page Réglages de Mire ; ce fichier sert
# seulement à imposer un réglage, qui est alors verrouillé dans la page.
# Pour l'utiliser : copiez-le en .env à côté de compose.yaml, décommentez les
# lignes voulues, et ajoutez « env_file: .env » au service mire.
# Protégez-le : chmod 600 .env (il peut contenir des mots de passe).
# Une valeur qui contient $, # ou une espace s'écrit entre apostrophes :
# MIRE_MQTT_MOT_DE_PASSE='mot de $passe'
# Après un changement : docker compose up -d. Liste complète dans le README.

# Fuseau horaire des heures affichées et des notifications ; par défaut,
# celui de l'opérateur (Europe/Brussels pour les profils belges).
# TZ=Europe/Brussels

# Adresse à laquelle vous ouvrez Mire : lien des notifications et de
# l'appareil Home Assistant. Par défaut, celle de la première visite.
# MIRE_NOTIF_ADRESSE=https://mire.exemple.be

# --- Modem et opérateur ---
# Mot de passe du modem, si vous préférez ne pas l'enregistrer dans la base.
# MIRE_MODEM_MOT_DE_PASSE=
# Profil d'opérateur, selon le réseau câble : voo (VOO, Orange sur VOO),
# telenet (Telenet, Orange sur Telenet) ou generique.
# MIRE_PROFIL=voo

# --- Débit, lu dans Speedtest Tracker ou sur une passerelle UniFi ---
# Speedtest Tracker : jeton du menu API Tokens, droit « Read results ».
# UniFi : clé API de UniFi Network, ou compte local de la console.
# MIRE_DEBIT=true
# MIRE_DEBIT_SOURCE=speedtest-tracker
# MIRE_DEBIT_ADRESSE=http://192.168.1.10:8080
# MIRE_DEBIT_JETON=
# MIRE_DEBIT_IDENTIFIANT=
# MIRE_DEBIT_MOT_DE_PASSE=

# --- Météo, pour la page Tendance ---
# Température relevée auprès d'Open-Meteo (gratuit, sans compte) : seule la
# position lui est envoyée. Une commune, ou latitude, longitude.
# MIRE_METEO=true
# MIRE_METEO_POSITION=Namur

# --- Métriques (Prometheus, VictoriaMetrics, Grafana Alloy, Telegraf) ---
# Publiées sur http://<machine>:1340/metrics. Le jeton, facultatif, est alors
# exigé en Authorization: Bearer ; créez-en un avec : openssl rand -hex 24
# MIRE_METRIQUES=true
# MIRE_METRIQUES_JETON=

# --- Home Assistant, par MQTT ---
# Un appareil « Mire » apparaît seul dans l'intégration MQTT.
# MIRE_MQTT=true
# MIRE_MQTT_SERVEUR=mqtt://192.168.1.10:1883
# MIRE_MQTT_IDENTIFIANT=
# MIRE_MQTT_MOT_DE_PASSE=
# Bouton « Redémarrer le modem » dans l'appareil ; false pour le retirer.
# MIRE_MQTT_REDEMARRAGE=true
